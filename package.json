{
  "name": "gutu-lib-geo",
  "private": true,
  "type": "module",
  "workspaces": [
    "framework/libraries/*"
  ],
  "scripts": {
    "build": "bun run --cwd framework/libraries/geo build",
    "typecheck": "bun run --cwd framework/libraries/geo typecheck",
    "lint": "bun run --cwd framework/libraries/geo lint",
    "test": "bun run --cwd framework/libraries/geo test",
    "test:unit": "bun run --cwd framework/libraries/geo test:unit",
    "docs:summary": "node scripts/docs-summary.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  }
}
